# Backend environment — copy to backend/.env and fill in real values.
# Values set here are passed into the container via the optional env_file mount.
# Secrets (SECRET_KEY, POSTGRES_PASSWORD) must also be set in the root .env
# so that the postgres service and compose variable interpolation can use them.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
USE_SQLITE=false
POSTGRES_USER=user
# REQUIRED — must match POSTGRES_PASSWORD in root .env
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=redline

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── ML Models ─────────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=tiny
INTENT_ONNX_PATH=/app/ml/intent/v1/intent_model.onnx
EMOTION_ONNX_PATH=/app/ml/emotion/v1/emotion_model.onnx
EMOTION_PT_PATH=/app/ml/emotion/v1/emotion_model.pt

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=redline-ai
OTEL_ENDPOINT=http://localhost:4317

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2

# ── External Services ─────────────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# ML_SERVICE_URL=http://localhost:8001
