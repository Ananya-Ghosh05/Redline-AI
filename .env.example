# ── Docker Compose secrets (copy to .env and fill in real values) ─────────────
# REQUIRED: these have no defaults in docker-compose.yml and must be set.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_ADMIN_PASSWORD

# ── Database ──────────────────────────────────────────────────────────────────
# Optional: override the defaults shown in docker-compose.yml
POSTGRES_USER=user
POSTGRES_DB=redline

# ── Runtime tuning (optional — defaults provided in docker-compose.yml) ───────
# WHISPER_MODEL_SIZE=tiny
# OTEL_ENABLED=false
# GUNICORN_WORKERS=2

# ── Node.js / legacy service ──────────────────────────────────────────────────
PORT=3000

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_PROJECT_ID=your_project_id
